# מפתח ה-API של Anthropic (Claude) - חובה
ANTHROPIC_API_KEY=

# איזה מודל Claude להשתמש בו לסיכומים
ANTHROPIC_MODEL=claude-sonnet-5

# מתי להריץ סיכום אוטומטי (cron syntax, לפי שעון השרת)
# ברירת מחדל: כל יום ב-20:00
SUMMARY_CRON=0 20 * * *

# האם לשלוח את הסיכום גם כהודעת וואטסאפ לעצמך (true/false)
SEND_SUMMARY_TO_SELF=true
